generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model PlatformHealth {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  checkedAt DateTime @default(now())
}

model User {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String         @unique
  passwordHash     String?
  isAdmin          Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  subscription     Subscription?
  quizAttempts     QuizAttempt[]
  createdQuestions Question[]     @relation("CreatedQuestions")
  createdMockTests MockTest[]     @relation("CreatedMockTests")
  interviewSessions InterviewSession[]
  interviewBookings InterviewBooking[]
}

model Subscription {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  userId      String              @unique @db.ObjectId
  user        User                @relation(fields: [userId], references: [id])
  plan        SubscriptionPlan    @default(FREE)
  status      SubscriptionStatus @default(ACTIVE)
  startsAt    DateTime            @default(now())
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  attempts    QuizAttempt[]
}

model Question {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  category      String
  difficulty    Difficulty       @default(MEDIUM)
  questionText  String
  options       Json
  correctOption Int
  explanation   String?
  isActive      Boolean          @default(true)
  createdById   String?          @db.ObjectId
  createdBy     User?            @relation("CreatedQuestions", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  answers       AttemptAnswer[]
  mockTestLinks MockTestQuestion[]
}

model MockTest {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  examName       String
  description    String?
  durationMinutes Int
  isPublished    Boolean           @default(false)
  createdById    String            @db.ObjectId
  createdBy      User              @relation("CreatedMockTests", fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  questions      MockTestQuestion[]
  attempts       QuizAttempt[]
}

model MockTestQuestion {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  mockTestId    String   @db.ObjectId
  mockTest      MockTest @relation(fields: [mockTestId], references: [id])
  questionId    String   @db.ObjectId
  question      Question @relation(fields: [questionId], references: [id])
  questionOrder Int
  createdAt     DateTime @default(now())

  @@unique([mockTestId, questionId])
}

model QuizAttempt {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  userId         String         @db.ObjectId
  user           User           @relation(fields: [userId], references: [id])
  mockTestId     String?        @db.ObjectId
  mockTest       MockTest?      @relation(fields: [mockTestId], references: [id])
  subscriptionId  String?        @db.ObjectId
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id])
  totalQuestions Int
  correctAnswers Int
  score          Int
  startedAt      DateTime       @default(now())
  submittedAt    DateTime?
  answers        AttemptAnswer[]
}

model AttemptAnswer {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  quizAttemptId String      @db.ObjectId
  attempt       QuizAttempt @relation(fields: [quizAttemptId], references: [id])
  questionId    String      @db.ObjectId
  question      Question    @relation(fields: [questionId], references: [id])
  selectedOption Int
  isCorrect     Boolean
  createdAt     DateTime    @default(now())
}

enum InterviewTrack {
  DSA
  SYSTEM_DESIGN
  DEVELOPMENT
}

enum InterviewLevel {
  JUNIOR
  MID
  SENIOR
}

enum InterviewSessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum InterviewBookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
}

// An AI mock interview. Messages are the plain-text transcript ({ role, content, hidden? }[]).
model InterviewSession {
  id           String                 @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                 @db.ObjectId
  user         User                   @relation(fields: [userId], references: [id])
  track        InterviewTrack
  level        InterviewLevel
  status       InterviewSessionStatus @default(IN_PROGRESS)
  messages     Json
  report       Json?
  overallScore Int?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  completedAt  DateTime?

  @@index([userId, createdAt])
}

// A one-hour interview with the human panel, paid offline and confirmed by an admin.
model InterviewBooking {
  id              String                 @id @default(auto()) @map("_id") @db.ObjectId
  userId          String                 @db.ObjectId
  user            User                   @relation(fields: [userId], references: [id])
  track           InterviewTrack
  scheduledAt     DateTime
  durationMinutes Int                    @default(60)
  priceInr        Int
  status          InterviewBookingStatus @default(PENDING_PAYMENT)
  notes           String?
  interviewerName String?
  meetingLink     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([scheduledAt])
  @@index([userId, scheduledAt])
}
